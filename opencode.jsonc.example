{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "plugin": ["./tools/plugins/speckit-perfmon.ts", "./tools/plugins/speckit-cache.ts", "./tools/plugins/speckit-guard.ts"],
  "permission": {
    "external_directory": {
      "~/.config/opencode/**": "allow"
    }
  }
}
